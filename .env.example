# Vital — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# Only keys the codebase actually reads are listed here.

# Local dev Postgres
DATABASE_URL=

# Claude AI (coach, meal reactions, proactive analysis)
ANTHROPIC_API_KEY=
# Model used by the proactive analysis worker. Optional — the code default is
# `claude-sonnet-5` (DEFAULT_PROACTIVE_ANALYSIS_MODEL in
# lib/proactiveAnalysisGeneration.ts). WARNING: this is currently set as a Fly
# secret in production and the env var OVERRIDES the code default, so changing
# DEFAULT_PROACTIVE_ANALYSIS_MODEL alone has NO production effect — you must
# also run `fly secrets set PROACTIVE_ANALYSIS_MODEL=...` (or unset it to let
# the code default win).
PROACTIVE_ANALYSIS_MODEL=

# Specialist sub-agents (lib/specialists). Disabled unless SPECIALISTS_ENABLED
# is exactly the string "true"; SPECIALIST_MODEL is required once enabled.
SPECIALISTS_ENABLED=
SPECIALIST_MODEL=

# CalorieNinjas (free-text nutrition estimate fallback)
CALORIENINJAS_API_KEY=

# USDA FoodData Central (nutrition candidate search + barcode GTIN lookup;
# free key: https://api.data.gov/signup)
USDA_FDC_API_KEY=

# ElevenLabs (coach voice TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Auth (jose-based session JWT + Sign in with Apple)
# Set matching values via `fly secrets set` before deploying middleware.ts changes.
SESSION_JWT_SECRET=
APPLE_BUNDLE_ID=
# Dev-auth bypass (env-gated; unset this in production once SIWA is wired up)
DEV_AUTH_SECRET=

# Local data directory for file-backed stores (memory templates, etc.)
VITAL_DATA_DIR=
# Overrides just the memory-template directory (defaults to a path under
# VITAL_DATA_DIR). See lib/memory.ts.
VITAL_MEMORY_TEMPLATE_DIR=

# Apple Push Notification service (proactive analysis + morning brief pushes).
# All four are required by scripts/proactive-health-worker.ts — it throws on
# startup if any is missing. APNS_PRIVATE_KEY holds the .p8 contents with
# literal "\n" escapes; the worker expands them back to real newlines.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY=

# WHOOP integration (OAuth connect + webhook; developer-dashboard.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the WHOOP Developer Dashboard
WHOOP_REDIRECT_URI=
